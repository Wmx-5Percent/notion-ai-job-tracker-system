# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored and must NEVER be committed or shared.

# Notion integration token ("Internal Integration Secret").
# Create it at https://www.notion.so/my-integrations
# Starts with "ntn_" (or the older "secret_").
NOTION_TOKEN=

# Your Job Tracker database ID (the 32-char id from the database URL).
NOTION_DATABASE_ID=

# Sandbox database ID (safe copy for testing; code writes here by default).
NOTION_SANDBOX_DATABASE_ID=
